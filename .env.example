# Klíč k Claude API (https://platform.claude.com -> API keys). Bez něj AI nepoběží.
ANTHROPIC_API_KEY=

# Heslo do aplikace. Nastav vždy, když apka poběží na internetu.
APP_PASSWORD=

# Nepovinné
# PORT=3000
